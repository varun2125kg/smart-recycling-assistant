# ==============================================================================
# EcoVision AI - Environment Configuration Example
# Copy this file to .env and configure your Google Gemini API key:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
# On Render: Set this as a secret environment variable in the Render Dashboard.
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 5050 for local dev; auto-provided as PORT on Render)
PORT=5050

# Active Gemini Model (Default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Flask Debug Mode (0 in production, 1 for local development)
FLASK_DEBUG=0

# Optional Persistent Storage Paths:
# (Set these if you attach a Render Persistent Disk mounted at /var/data)
# DATABASE_PATH=/var/data/ecovision.db
# UPLOAD_FOLDER=/var/data/uploads
